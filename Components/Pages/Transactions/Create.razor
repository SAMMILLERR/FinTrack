@page "/transactions/create"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@attribute [Authorize]

@using System.Security.Claims
@using FinTrack.Models
@using FinTrack.Services.Interfaces

@inject ITransactionService TransactionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Add Transaction</PageTitle>

<h2 class="mb-4">
    Add @Type Transaction
</h2>

<div class="mb-3">

    <button type="button"
            class="btn @(Type == "Income" ? "btn-success" : "btn-outline-success") me-2"
            @onclick="SetIncome">

        Income

    </button>

    <button type="button"
            class="btn @(Type == "Expense" ? "btn-danger" : "btn-outline-danger")"
            @onclick="SetExpense">

        Expense

    </button>

</div>

@if (IsLoading)
{
    <div class="alert alert-info">
        Loading categories...
    </div>
}
else
{
    <EditForm Model="Transaction"
              OnValidSubmit="SaveTransaction"
              FormName="transactionCreateForm">

        <DataAnnotationsValidator />

        <ValidationSummary />

        <div class="mb-3">

            <label class="form-label">
                Category
            </label>

            <InputSelect @bind-Value="Transaction.CategoryId"
                         class="form-select">

                <option value="0">
                    -- Select Category --
                </option>

                @foreach (var category in Categories)
                {
                    <option value="@category.CategoryId">
                        @category.CategoryName
                    </option>
                }

            </InputSelect>

            <ValidationMessage For="@(() => Transaction.CategoryId)" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Amount
            </label>

            <InputNumber @bind-Value="Transaction.Amount"
                         class="form-control" />

            <ValidationMessage For="@(() => Transaction.Amount)" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Transaction Date
            </label>

            <InputDate @bind-Value="Transaction.TransactionDate"
                       class="form-control" />

            <ValidationMessage For="@(() => Transaction.TransactionDate)" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Description
            </label>

            <InputTextArea @bind-Value="Transaction.Description"
                           class="form-control" />

            <ValidationMessage For="@(() => Transaction.Description)" />

        </div>

        @if (!string.IsNullOrEmpty(BudgetWarning))
        {
            <div class="alert alert-warning">

                <div class="d-flex">

                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                    <div>

                        <strong>Budget warning</strong>

                        <div class="mt-1">
                            @BudgetWarning
                        </div>

                    </div>

                </div>

            </div>
        }

        @if (ShowBudgetConfirmation)
        {
            <div class="alert alert-danger">

                <div class="d-flex">

                    <i class="bi bi-shield-exclamation fs-4 me-3"></i>

                    <div class="w-100">

                        <h5 class="alert-heading">
                            Budget limit exceeded
                        </h5>

                        <p>
                            This expense will cause your
                            <strong>@BudgetCategoryName</strong>
                            budget to exceed its monthly limit.
                        </p>

                        <div class="row mb-3">

                            <div class="col-md-6">
                                <strong>Monthly budget:</strong>
                                ₹@BudgetLimit.ToString("N2")
                            </div>

                            <div class="col-md-6">
                                <strong>Already spent:</strong>
                                ₹@CurrentSpent.ToString("N2")
                            </div>

                            <div class="col-md-6 mt-2">
                                <strong>This expense:</strong>
                                ₹@Transaction.Amount.ToString("N2")
                            </div>

                            <div class="col-md-6 mt-2">
                                <strong>Projected spending:</strong>
                                ₹@ProjectedSpent.ToString("N2")
                            </div>

                        </div>

                        <div class="alert alert-light border">

                            <strong>FinTrack disclaimer</strong>

                            <p class="mb-0 mt-1">
                                FinTrack recommends staying within your
                                configured budget. Proceeding will cause
                                this category to exceed its monthly limit.
                                You are choosing to override this
                                budgeting safeguard.
                            </p>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="button"
                                    class="btn btn-secondary"
                                    @onclick="CancelBudgetOverride">

                                Cancel

                            </button>

                            <button type="button"
                                    class="btn btn-danger"
                                    @onclick="ProceedDespiteBudget">

                                <i class="bi bi-exclamation-triangle"></i>

                                Proceed Anyway

                            </button>

                        </div>

                    </div>

                </div>

            </div>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        @if (!ShowBudgetConfirmation)
        {
            <button type="submit"
                    class="btn btn-primary"
                    disabled="@IsSaving">

                @(IsSaving ? "Saving..." : "Save")

            </button>
        }

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Cancel">

            Cancel

        </button>

    </EditForm>
}

@code
{
    private Transaction Transaction { get; set; } = new();

    private List<Category> Categories { get; set; } = new();

    private string Type { get; set; } = "Expense";

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;

    private string? BudgetWarning;

    private bool ShowBudgetConfirmation;

    private decimal BudgetLimit;

    private decimal CurrentSpent;

    private decimal ProjectedSpent;

    private string BudgetCategoryName = "";

    protected override async Task OnInitializedAsync()
    {
        Transaction.TransactionDate = DateTime.Today;
        Transaction.TransactionType = Type;

        await LoadCategories();

        IsLoading = false;
    }

    private async Task SetIncome()
    {
        await ChangeType("Income");
    }

    private async Task SetExpense()
    {
        await ChangeType("Expense");
    }

    private async Task ChangeType(string type)
    {
        Type = type;

        Transaction.TransactionType = Type;
        Transaction.CategoryId = 0;

        ClearBudgetMessages();

        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        var categories =
            await TransactionService
                .GetCategoriesByTypeAsync(Type);

        Categories = categories.ToList();
    }

    private async Task SaveTransaction()
    {
        try
        {
            IsSaving = true;

            ErrorMessage = null;
            BudgetWarning = null;

            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authenticationState.User;

            var claim =
                user.FindFirst(
                    ClaimTypes.NameIdentifier);

            if (claim == null ||
                !int.TryParse(
                    claim.Value,
                    out var userId))
            {
                ErrorMessage =
                    "Unable to identify the current user.";

                return;
            }

            Transaction.UserId = userId;
            Transaction.TransactionType = Type;

            if (Type.Equals(
                    "Expense",
                    StringComparison.OrdinalIgnoreCase))
            {
                var budget =
                    await TransactionService
                        .GetBudgetForTransactionAsync(
                            Transaction);

                if (budget != null)
                {
                    CurrentSpent = budget.SpentAmount;

                    ProjectedSpent =
                        CurrentSpent + Transaction.Amount;

                    BudgetLimit = budget.LimitAmount;

                    var category =
                        Categories.FirstOrDefault(
                            c => c.CategoryId ==
                                 Transaction.CategoryId);

                    BudgetCategoryName =
                        category?.CategoryName ??
                        budget.CategoryName;

                    if (ProjectedSpent > BudgetLimit)
                    {
                        ShowBudgetConfirmation = true;

                        return;
                    }

                    if (ProjectedSpent >= BudgetLimit * 0.80m)
                    {
                        var remaining =
                            BudgetLimit - ProjectedSpent;

                        BudgetWarning =
                            $"This expense will leave only " +
                            $"₹{remaining:N2} remaining in your " +
                            $"monthly {BudgetCategoryName} budget.";
                    }
                }
            }

            await TransactionService
                .AddTransactionAsync(Transaction);

            Navigation.NavigateTo("/transactions");
        }
        catch (Exception)
        {
            ErrorMessage =
                "Unable to save the transaction right now.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ProceedDespiteBudget()
    {
        try
        {
            IsSaving = true;
            ErrorMessage = null;

            await TransactionService
                .AddTransactionAsync(Transaction);

            Navigation.NavigateTo("/transactions");
        }
        catch (Exception)
        {
            ErrorMessage =
                "Unable to save the transaction right now.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void CancelBudgetOverride()
    {
        ShowBudgetConfirmation = false;

        ErrorMessage = null;
    }

    private void ClearBudgetMessages()
    {
        ErrorMessage = null;
        BudgetWarning = null;
        ShowBudgetConfirmation = false;
    }

    private void Cancel()
    {
        Navigation.NavigateTo(
            "/transactions",
            forceLoad: false);
    }
}