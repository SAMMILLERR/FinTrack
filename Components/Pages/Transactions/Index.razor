@page "/transactions"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@using System.Security.Claims
@using FinTrack.Models
@using FinTrack.Services.Interfaces

@inject ITransactionService TransactionService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Transactions | FinTrack</PageTitle>


@if (IsLoading)
{
    <div class="transactions-loading">

        <div class="transaction-loader"></div>

        <span>
            Loading transactions...
        </span>

    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="transactions-error">

        <i class="bi bi-exclamation-triangle"></i>

        <div>

            <strong>
                Transactions unavailable
            </strong>

            <span>
                @ErrorMessage
            </span>

        </div>

    </div>
}
else
{
    <div class="transactions-page">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="transactions-header">

            <div>

                <span class="transactions-eyebrow">
                    PERSONAL FINANCE
                </span>

                <h1>
                    Transactions
                </h1>

                <p>
                    Track your income and spending activity.
                </p>

            </div>

        </div>


        <!-- =====================================================
             MONTH NAVIGATION
             ===================================================== -->

        <div class="calendar-toolbar">

            <div class="calendar-month-navigation">

                <button type="button"
                        class="month-nav-button"
                        @onclick="PreviousMonth">

                    <i class="bi bi-chevron-left"></i>

                </button>


                <div class="calendar-month-title">

                    <strong>
                        @CurrentMonth.ToString("MMMM yyyy")
                    </strong>

                    <span>
                        @MonthTransactionCount transaction@(MonthTransactionCount == 1 ? "" : "s")
                    </span>

                </div>


                <button type="button"
                        class="month-nav-button"
                        @onclick="NextMonth">

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>


            <button type="button"
                    class="today-button"
                    @onclick="GoToToday">

                Today

            </button>

        </div>


        <!-- =====================================================
             MONTH SUMMARY
             ===================================================== -->

        <div class="transaction-summary-grid">


            <div class="transaction-summary-card">

                <div class="transaction-summary-icon income-icon">

                    <i class="bi bi-arrow-down-left"></i>

                </div>

                <div>

                    <span>
                        Income
                    </span>

                    <strong class="income-text">
                        +₹@MonthIncome.ToString("N0")
                    </strong>

                </div>

            </div>


            <div class="transaction-summary-card">

                <div class="transaction-summary-icon expense-icon">

                    <i class="bi bi-arrow-up-right"></i>

                </div>

                <div>

                    <span>
                        Expenses
                    </span>

                    <strong class="expense-text">
                        -₹@MonthExpense.ToString("N0")
                    </strong>

                </div>

            </div>


            <div class="transaction-summary-card">

                <div class="transaction-summary-icon balance-icon">

                    <i class="bi bi-wallet2"></i>

                </div>

                <div>

                    <span>
                        Net
                    </span>

                    <strong class="@(MonthNet >= 0 ? "income-text" : "expense-text")">
                        @(MonthNet >= 0 ? "+" : "-")₹@Math.Abs(MonthNet).ToString("N0")
                    </strong>

                </div>

            </div>


            <div class="transaction-summary-card">

                <div class="transaction-summary-icon count-icon">

                    <i class="bi bi-receipt"></i>

                </div>

                <div>

                    <span>
                        Transactions
                    </span>

                    <strong>
                        @MonthTransactionCount
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <div class="transaction-filter-card">

            <div class="filter-header">

                <div>

                    <span class="transactions-eyebrow">
                        FILTERS
                    </span>

                    <strong>
                        Find transactions
                    </strong>

                </div>


                @if (HasActiveFilters)
                {
                    <button type="button"
                            class="clear-filter-button"
                            @onclick="ClearFilters">

                        Clear filters

                    </button>
                }

            </div>


            <div class="transaction-filter-grid">


                <!-- CATEGORY -->

                <div class="transaction-filter-field">

                    <label>
                        Category
                    </label>

                    <select class="transaction-filter-input"
                            @bind="CategoryId">

                        <option value="">
                            All categories
                        </option>

                        @foreach (var category in Categories)
                        {
                            <option value="@category.CategoryId">
                                @category.CategoryName
                            </option>
                        }

                    </select>

                </div>


                <!-- TYPE -->

                <div class="transaction-filter-field">

                    <label>
                        Type
                    </label>

                    <select class="transaction-filter-input"
                            @bind="Type">

                        <option value="">
                            All transactions
                        </option>

                        <option value="Income">
                            Income
                        </option>

                        <option value="Expense">
                            Expense
                        </option>

                    </select>

                </div>


                <!-- SEARCH -->

                <div class="transaction-filter-field search-field">

                    <label>
                        Search
                    </label>

                    <input type="text"
                           class="transaction-filter-input"
                           placeholder="Search description..."
                           @bind="SearchText"
                           @bind:event="oninput" />

                </div>


                <div class="transaction-filter-action">

                    <button type="button"
                            class="filter-apply-button"
                            @onclick="ApplyFilters">

                        <i class="bi bi-search"></i>

                        Filter

                    </button>

                </div>

            </div>

        </div>


        <!-- =====================================================
             CALENDAR
             ===================================================== -->

        <div class="transaction-calendar-card">


            <!-- WEEK DAYS -->

            <div class="calendar-weekdays">

                <div>
                    MON
                </div>

                <div>
                    TUE
                </div>

                <div>
                    WED
                </div>

                <div>
                    THU
                </div>

                <div>
                    FRI
                </div>

                <div>
                    SAT
                </div>

                <div>
                    SUN
                </div>

            </div>


            <!-- CALENDAR DAYS -->

            <div class="calendar-grid">

                @foreach (var day in CalendarDays)
                {
                    if (day.IsEmpty)
                    {
                        <div class="calendar-day empty-day"></div>
                    }
                    else
                    {
                        var dayDate = day.Date;

                        var dayTransactions =
                            GetTransactionsForDate(dayDate);

                        var dayIncome =
                            GetIncomeForDate(dayDate);

                        var dayExpense =
                            GetExpenseForDate(dayDate);

                        var isSelected =
                            SelectedDate.HasValue &&
                            SelectedDate.Value.Date == dayDate.Date;

                        var isToday =
                            dayDate.Date == DateTime.Today;


                        <button type="button"
                                class="calendar-day @(isToday ? "today-day" : "") @(isSelected ? "selected-day" : "")"
                                @onclick="() => SelectDate(dayDate)">

                            <div class="calendar-day-top">

                                <span class="calendar-day-number">
                                    @dayDate.Day
                                </span>

                                @if (dayTransactions.Any())
                                {
                                    <span class="day-transaction-count">
                                        @dayTransactions.Count()
                                    </span>
                                }

                            </div>


                            @if (dayIncome > 0)
                            {
                                <div class="calendar-income">
                                    +₹@dayIncome.ToString("N0")
                                </div>
                            }


                            @if (dayExpense > 0)
                            {
                                <div class="calendar-expense">
                                    -₹@dayExpense.ToString("N0")
                                </div>
                            }


                            @if (dayIncome == 0 &&
                                 dayExpense == 0)
                            {
                                <div class="calendar-empty-label">
                                    —
                                </div>
                            }

                        </button>
                    }
                }

            </div>

        </div>


        <!-- =====================================================
             SELECTED DAY
             ===================================================== -->

        @if (SelectedDate.HasValue)
        {
            var selectedTransactions =
                GetTransactionsForDate(
                    SelectedDate.Value);


            <section class="selected-day-section">


                <!-- DAY HEADER -->

                <div class="selected-day-header">

                    <div>

                        <span class="transactions-eyebrow">
                            SELECTED DAY
                        </span>

                        <h2>
                            @SelectedDate.Value.ToString("dddd, dd MMMM yyyy")
                        </h2>

                    </div>


                    <div class="selected-day-summary">

                        <div>

                            <span>
                                Income
                            </span>

                            <strong class="income-text">
                                +₹@GetIncomeForDate(SelectedDate.Value).ToString("N0")
                            </strong>

                        </div>


                        <div>

                            <span>
                                Expense
                            </span>

                            <strong class="expense-text">
                                -₹@GetExpenseForDate(SelectedDate.Value).ToString("N0")
                            </strong>

                        </div>

                    </div>

                </div>


                @if (!selectedTransactions.Any())
                {
                    <div class="selected-day-empty">

                        <div class="selected-empty-icon">

                            <i class="bi bi-calendar2-check"></i>

                        </div>

                        <strong>
                            No transactions on this day
                        </strong>

                        <span>
                            Select another date to view transactions.
                        </span>

                    </div>
                }
                else
                {
                    <div class="selected-transactions-list">

                        @foreach (var transaction in selectedTransactions)
                        {
                            var isIncome =
                                string.Equals(
                                    transaction.TransactionType,
                                    "Income",
                                    StringComparison.OrdinalIgnoreCase);


                            <div class="transaction-item">


                                <!-- ICON -->

                                <div class="transaction-item-icon @(isIncome ? "transaction-income-icon" : "transaction-expense-icon")">

                                    <i class="bi @(isIncome ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>

                                </div>


                                <!-- DETAILS -->

                                <div class="transaction-item-details">

                                    <strong>
                                        @transaction.CategoryName
                                    </strong>

                                    <span>

                                        @(string.IsNullOrWhiteSpace(transaction.Description)
                                            ? "No description"
                                            : transaction.Description)

                                    </span>


                                    <div class="transaction-item-meta">

                                        <span>
                                            @transaction.TransactionDate.ToString("hh:mm tt")
                                        </span>


                                        @if (transaction.RecurringPaymentId.HasValue)
                                        {
                                            <span class="recurring-badge">

                                                <i class="bi bi-arrow-repeat"></i>

                                                Recurring

                                            </span>
                                        }

                                    </div>

                                </div>


                                <!-- AMOUNT -->

                                <div class="transaction-item-amount">

                                    <strong class="@(isIncome ? "income-text" : "expense-text")">

                                        @(isIncome ? "+" : "-")₹@transaction.Amount.ToString("N0")

                                    </strong>

                                    <span class="transaction-type-label @(isIncome ? "income-label" : "expense-label")">

                                        @(isIncome ? "Income" : "Expense")

                                    </span>

                                </div>

                            </div>
                        }

                    </div>
                }

            </section>
        }


        <!-- =====================================================
             ALL TRANSACTIONS
             ===================================================== -->

        <section class="all-transactions-section">

            <div class="all-transactions-header">

                <div>

                    <span class="transactions-eyebrow">
                        ACTIVITY
                    </span>

                    <h2>
                        All transactions
                    </h2>

                </div>

                <span class="transaction-result-count">
                    @FilteredTransactions.Count() results
                </span>

            </div>


            @if (!FilteredTransactions.Any())
            {
                <div class="selected-day-empty">

                    <div class="selected-empty-icon">

                        <i class="bi bi-receipt"></i>

                    </div>

                    <strong>
                        No transactions found
                    </strong>

                    <span>
                        Try changing your filters.
                    </span>

                </div>
            }
            else
            {
                <div class="selected-transactions-list">

                    @foreach (var transaction in FilteredTransactions)
                    {
                        var isIncome =
                            string.Equals(
                                transaction.TransactionType,
                                "Income",
                                StringComparison.OrdinalIgnoreCase);


                        <div class="transaction-item">


                            <div class="transaction-item-icon @(isIncome ? "transaction-income-icon" : "transaction-expense-icon")">

                                <i class="bi @(isIncome ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>

                            </div>


                            <div class="transaction-item-details">

                                <strong>
                                    @transaction.CategoryName
                                </strong>

                                <span>

                                    @(string.IsNullOrWhiteSpace(transaction.Description)
                                        ? "No description"
                                        : transaction.Description)

                                </span>


                                <div class="transaction-item-meta">

                                    <span>
                                        @transaction.TransactionDate.ToString("dd MMM yyyy")
                                    </span>


                                    @if (transaction.RecurringPaymentId.HasValue)
                                    {
                                        <span class="recurring-badge">

                                            <i class="bi bi-arrow-repeat"></i>

                                            Recurring

                                        </span>
                                    }


                                    @if (IsAdmin)
                                    {
                                        <span>
                                            User: @transaction.UserName
                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="transaction-item-amount">

                                <strong class="@(isIncome ? "income-text" : "expense-text")">

                                    @(isIncome ? "+" : "-")₹@transaction.Amount.ToString("N0")

                                </strong>

                                <span class="transaction-type-label @(isIncome ? "income-label" : "expense-label")">

                                    @(isIncome ? "Income" : "Expense")

                                </span>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>

    </div>
}


@code
{
    // =========================================================
    // DATA
    // =========================================================

    private IEnumerable<Transaction> Transactions =
        new List<Transaction>();

    private IEnumerable<Category> Categories =
        new List<Category>();


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;

    private bool IsAdmin;

    private string? ErrorMessage;

    private int? UserId;


    // =========================================================
    // CALENDAR
    // =========================================================

    private DateTime CurrentMonth =
        new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);

    private DateTime? SelectedDate;


    // =========================================================
    // FILTERS
    // =========================================================

    private int? CategoryId;

    private string? Type;

    private string SearchText = "";


    // =========================================================
    // MONTH DATA
    // =========================================================

    private decimal MonthIncome =>
        Transactions
            .Where(IsIncome)
            .Sum(x => x.Amount);


    private decimal MonthExpense =>
        Transactions
            .Where(IsExpense)
            .Sum(x => x.Amount);


    private decimal MonthNet =>
        MonthIncome - MonthExpense;


    private int MonthTransactionCount =>
        Transactions.Count();


    private IEnumerable<Transaction> FilteredTransactions =>
        Transactions
            .Where(TransactionMatchesFilters)
            .OrderByDescending(
                x => x.TransactionDate);


    private bool HasActiveFilters =>
        CategoryId.HasValue ||
        !string.IsNullOrWhiteSpace(Type) ||
        !string.IsNullOrWhiteSpace(SearchText);


    // =========================================================
    // CALENDAR DAY MODEL
    // =========================================================

    private IEnumerable<CalendarDay> CalendarDays
    {
        get
        {
            var firstDay =
                new DateTime(
                    CurrentMonth.Year,
                    CurrentMonth.Month,
                    1);

            var daysInMonth =
                DateTime.DaysInMonth(
                    CurrentMonth.Year,
                    CurrentMonth.Month);


            // Monday = 1
            var startOffset =
                ((int)firstDay.DayOfWeek + 6) % 7;


            var days =
                new List<CalendarDay>();


            for (var i = 0;
                 i < startOffset;
                 i++)
            {
                days.Add(
                    new CalendarDay
                    {
                        IsEmpty = true
                    });
            }


            for (var day = 1;
                 day <= daysInMonth;
                 day++)
            {
                days.Add(
                    new CalendarDay
                    {
                        Date =
                            new DateTime(
                                CurrentMonth.Year,
                                CurrentMonth.Month,
                                day),

                        IsEmpty = false
                    });
            }


            while (days.Count % 7 != 0)
            {
                days.Add(
                    new CalendarDay
                    {
                        IsEmpty = true
                    });
            }


            return days;
        }
    }


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();


            var user =
                authenticationState.User;


            IsAdmin =
                user.IsInRole("Admin");


            if (!IsAdmin)
            {
                var claim =
                    user.FindFirst(
                        ClaimTypes.NameIdentifier);


                if (claim == null ||
                    !int.TryParse(
                        claim.Value,
                        out var id))
                {
                    ErrorMessage =
                        "Unable to identify the current user.";

                    return;
                }


                UserId = id;
            }


            Categories =
                await TransactionService
                    .GetCategoriesAsync();


            await LoadMonthTransactions();
        }
        catch (Exception)
        {
            ErrorMessage =
                "Unable to load transactions right now.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // LOAD MONTH
    // =========================================================

    private async Task LoadMonthTransactions()
    {
        var monthStart =
            new DateTime(
                CurrentMonth.Year,
                CurrentMonth.Month,
                1);


        var monthEnd =
            monthStart.AddMonths(1).AddDays(-1);


        var result =
            await TransactionService.GetTransactionsAsync(
                UserId,
                monthStart,
                monthEnd,
                null,
                null,
                1,
                1000);


        Transactions =
            result.Transactions
                .ToList();


        if (SelectedDate.HasValue &&
            (SelectedDate.Value.Month != CurrentMonth.Month ||
             SelectedDate.Value.Year != CurrentMonth.Year))
        {
            SelectedDate = null;
        }
    }


    // =========================================================
    // MONTH NAVIGATION
    // =========================================================

    private async Task PreviousMonth()
    {
        CurrentMonth =
            CurrentMonth.AddMonths(-1);


        SelectedDate = null;


        await LoadMonthTransactions();
    }


    private async Task NextMonth()
    {
        CurrentMonth =
            CurrentMonth.AddMonths(1);


        SelectedDate = null;


        await LoadMonthTransactions();
    }


    private async Task GoToToday()
    {
        CurrentMonth =
            new DateTime(
                DateTime.Today.Year,
                DateTime.Today.Month,
                1);


        SelectedDate =
            DateTime.Today;


        await LoadMonthTransactions();
    }


    // =========================================================
    // DATE SELECTION
    // =========================================================

    private void SelectDate(DateTime date)
    {
        SelectedDate =
            date.Date;
    }


    // =========================================================
    // DAILY CALCULATIONS
    // =========================================================

    private IEnumerable<Transaction> GetTransactionsForDate(
        DateTime date)
    {
        return Transactions
            .Where(x =>
                x.TransactionDate.Date ==
                date.Date)
            .Where(TransactionMatchesFilters)
            .OrderByDescending(
                x => x.TransactionDate);
    }


    private decimal GetIncomeForDate(
        DateTime date)
    {
        return GetTransactionsForDate(date)
            .Where(IsIncome)
            .Sum(x => x.Amount);
    }


    private decimal GetExpenseForDate(
        DateTime date)
    {
        return GetTransactionsForDate(date)
            .Where(IsExpense)
            .Sum(x => x.Amount);
    }


    // =========================================================
    // TRANSACTION TYPE
    // =========================================================

    private bool IsIncome(
        Transaction transaction)
    {
        return string.Equals(
            transaction.TransactionType,
            "Income",
            StringComparison.OrdinalIgnoreCase);
    }


    private bool IsExpense(
        Transaction transaction)
    {
        return !IsIncome(transaction);
    }


    // =========================================================
    // FILTERING
    // =========================================================

    private bool TransactionMatchesFilters(
        Transaction transaction)
    {
        if (CategoryId.HasValue &&
            transaction.CategoryId != CategoryId.Value)
        {
            return false;
        }


        if (!string.IsNullOrWhiteSpace(Type) &&
            !string.Equals(
                transaction.TransactionType,
                Type,
                StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }


        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var search =
                SearchText.Trim();


            var matchesDescription =
                !string.IsNullOrWhiteSpace(
                    transaction.Description) &&
                transaction.Description
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase);


            var matchesCategory =
                !string.IsNullOrWhiteSpace(
                    transaction.CategoryName) &&
                transaction.CategoryName
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase);


            if (!matchesDescription &&
                !matchesCategory)
            {
                return false;
            }
        }


        return true;
    }


    private async Task ApplyFilters()
    {
        StateHasChanged();

        await Task.CompletedTask;
    }


    private void ClearFilters()
    {
        CategoryId = null;

        Type = null;

        SearchText = "";

        StateHasChanged();
    }


    // =========================================================
    // CALENDAR DAY MODEL
    // =========================================================

    private sealed class CalendarDay
    {
        public DateTime Date { get; set; }

        public bool IsEmpty { get; set; }
    }
}