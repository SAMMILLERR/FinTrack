@page "/recurring-payments/create"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@using System.Security.Claims
@using FinTrack.Models
@using FinTrack.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "User")]

@inject IRecurringPaymentService RecurringPaymentService
@inject ICategoryService CategoryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Create Recurring Payment</PageTitle>

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-7">

        <div class="d-flex align-items-center mb-4">
            <a href="/recurring-payments"
               class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i>
            </a>

            <div>
                <h1 class="mb-1">Create Recurring Payment</h1>
                <p class="text-muted mb-0">
                    Set up an automatic income or expense schedule.
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <EditForm Model="RecurringPayment"
                          OnValidSubmit="CreateRecurringPayment"
                          FormName="recurringPaymentCreateForm">

                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">
                            Payment Name
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="RecurringPayment.PaymentName"
                                   placeholder="e.g. Salary, Netflix Subscription" />

                        <ValidationMessage For="@(() => RecurringPayment.PaymentName)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Amount
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                ₹
                            </span>

                            <InputNumber class="form-control"
                                         @bind-Value="RecurringPayment.Amount"
                                         step="0.01" />
                        </div>

                        <ValidationMessage For="@(() => RecurringPayment.Amount)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Category
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="RecurringPayment.CategoryId">

                            <option value="0">
                                -- Select Category --
                            </option>

                            @foreach (var category in Categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.CategoryName
                                    (@category.CategoryTypeName)
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => RecurringPayment.CategoryId)" />

                        <div class="form-text">
                            Select an Income category for salary or other income,
                            or an Expense category for recurring expenses.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Frequency
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="RecurringPayment.Frequency">

                            <option value="Weekly">
                                Weekly
                            </option>

                            <option value="Monthly">
                                Monthly
                            </option>

                            <option value="Yearly">
                                Yearly
                            </option>

                        </InputSelect>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Start Date
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="RecurringPayment.StartDate" />

                            <ValidationMessage For="@(() => RecurringPayment.StartDate)" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                End Date
                                <span class="text-muted">
                                    (Optional)
                                </span>
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="RecurringPayment.EndDate" />

                            <ValidationMessage For="@(() => RecurringPayment.EndDate)" />

                        </div>

                    </div>

                    <div class="alert alert-info">

                        <i class="bi bi-info-circle me-2"></i>

                        FinTrack will automatically create a normal
                        transaction whenever this schedule becomes due.
                        The transaction will be marked as
                        <strong>Income</strong> or <strong>Expense</strong>
                        based on the selected category.

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a href="/recurring-payments"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@IsSaving">

                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1"></i>
                                <span>Create Recurring Payment</span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>

</div>

@code {

    private RecurringPayment RecurringPayment = new()
    {
        Frequency = "Monthly",
        StartDate = DateTime.Today,
        NextPaymentDate = DateTime.Today
    };

    private List<Category> Categories = new();

    private bool IsSaving;

    private string? ErrorMessage;

    private int UserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            var userIdClaim =
                user.FindFirst(ClaimTypes.NameIdentifier);

            if (userIdClaim == null ||
                !int.TryParse(userIdClaim.Value, out UserId))
            {
                ErrorMessage =
                    "Unable to identify the current user.";

                return;
            }

            var categories =
                await CategoryService
                    .GetCategoriesAsync();

            // IMPORTANT:
            // Load BOTH Income and Expense categories.
            Categories =
                categories
                    .Where(c => c.IsActive)
                    .OrderBy(c => c.CategoryTypeName)
                    .ThenBy(c => c.CategoryName)
                    .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Unable to load categories.";

            Console.WriteLine(ex);
        }
    }

    private async Task CreateRecurringPayment()
    {
        ErrorMessage = null;
        IsSaving = true;

        try
        {
            if (RecurringPayment.CategoryId <= 0)
            {
                ErrorMessage = "Please select a category.";
                return;
            }

            var selectedCategory =
                Categories.FirstOrDefault(
                    c => c.CategoryId == RecurringPayment.CategoryId);

            if (selectedCategory == null)
            {
                ErrorMessage = "Selected category could not be found.";
                return;
            }

            RecurringPayment.UserId = UserId;

            // Category determines whether this is Income or Expense.
            RecurringPayment.TransactionType =
                selectedCategory.CategoryTypeName;

            await RecurringPaymentService
                .AddRecurringPaymentAsync(
                    RecurringPayment);

            Navigation.NavigateTo(
                "/recurring-payments");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Unable to create the recurring payment.";

            Console.WriteLine(ex);
        }
        finally
        {
            IsSaving = false;
        }
    }
}