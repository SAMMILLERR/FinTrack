@page "/recurring-payments/create"

@using System.Security.Claims
@using FinTrack.Models
@using FinTrack.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "User")]

@inject IRecurringPaymentService RecurringPaymentService
@inject ICategoryService CategoryService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Create Recurring Payment</PageTitle>

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-7">

        <div class="d-flex align-items-center mb-4">

            <a href="/recurring-payments"
               class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i>
            </a>

            <div>
                <h1 class="mb-1">Create Recurring Payment</h1>

                <p class="text-muted mb-0">
                    Set up an automatic recurring transfer to another FinTrack user.
                </p>
            </div>

        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <EditForm Model="RecurringPayment"
                          OnValidSubmit="CreateRecurringPayment"
                          FormName="recurringPaymentCreateForm">

                    <DataAnnotationsValidator />

                    <!-- PAYMENT NAME -->

                    <div class="mb-3">

                        <label class="form-label">
                            Payment Name
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="RecurringPayment.PaymentName"
                                   placeholder="e.g. Monthly Gym Payment" />

                        <ValidationMessage For="@(() => RecurringPayment.PaymentName)" />

                    </div>


                    <!-- AMOUNT -->

                    <div class="mb-3">

                        <label class="form-label">
                            Amount
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <InputNumber class="form-control"
                                         @bind-Value="RecurringPayment.Amount"
                                         step="0.01" />

                        </div>

                        <ValidationMessage For="@(() => RecurringPayment.Amount)" />

                    </div>


                    <!-- RECEIVER -->

                    <div class="mb-3">

                        <label class="form-label">
                            Send To
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="RecurringPayment.ToUserId">

                            <option value="0">
                                -- Select Receiver --
                            </option>

                            @foreach (var user in Users)
                            {
                                <option value="@user.UserId">
                                    @user.FirstName @user.LastName
                                    (@user.Email)
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => RecurringPayment.ToUserId)" />

                        <div class="form-text">
                            Select the FinTrack user who will receive this recurring payment.
                        </div>

                    </div>


                    <!-- EXPENSE CATEGORY -->

                    <div class="mb-3">

                        <label class="form-label">
                            Expense Category
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="RecurringPayment.CategoryId">

                            <option value="0">
                                -- Select Expense Category --
                            </option>

                            @foreach (var category in Categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.CategoryName
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => RecurringPayment.CategoryId)" />

                        <div class="form-text">
                            This category records the transfer as an expense for the sender.
                        </div>

                    </div>


                    <!-- FREQUENCY -->

                    <div class="mb-3">

                        <label class="form-label">
                            Frequency
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="RecurringPayment.Frequency">

                            <option value="Weekly">
                                Weekly
                            </option>

                            <option value="Monthly">
                                Monthly
                            </option>

                            <option value="Yearly">
                                Yearly
                            </option>

                        </InputSelect>

                    </div>


                    <!-- DATES -->

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Start Date
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="RecurringPayment.StartDate" />

                            <ValidationMessage For="@(() => RecurringPayment.StartDate)" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                End Date

                                <span class="text-muted">
                                    (Optional)
                                </span>

                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="RecurringPayment.EndDate" />

                            <ValidationMessage For="@(() => RecurringPayment.EndDate)" />

                        </div>

                    </div>


                    <!-- INFORMATION -->

                    <div class="alert alert-info">

                        <i class="bi bi-arrow-left-right me-2"></i>

                        FinTrack will automatically process this transfer whenever it becomes due.

                        <br />

                        <strong>
                            Your account will be charged as an Expense,
                            and the receiver will receive it as Income.
                        </strong>

                    </div>


                    <!-- ACTIONS -->

                    <div class="d-flex justify-content-end gap-2">

                        <a href="/recurring-payments"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@IsSaving">

                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>

                                <span>
                                    Creating...
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-repeat me-1"></i>

                                <span>
                                    Create Recurring Payment
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>

</div>


@code {

    private RecurringPayment RecurringPayment = new()
    {
        Frequency = "Monthly",
        StartDate = DateTime.Today,
        NextPaymentDate = DateTime.Today,
        IsActive = true
    };

    private List<Category> Categories = new();

    private List<User> Users = new();

    private bool IsSaving;

    private string? ErrorMessage;

    private int UserId;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            var userIdClaim =
                user.FindFirst(ClaimTypes.NameIdentifier);

            if (userIdClaim == null ||
                !int.TryParse(userIdClaim.Value, out UserId))
            {
                ErrorMessage =
                    "Unable to identify the current user.";

                return;
            }


            // =====================================================
            // LOAD EXPENSE CATEGORIES
            // =====================================================

            var categories =
                await CategoryService
                    .GetCategoriesAsync();

            Categories =
                categories
                    .Where(c =>
                        c.IsActive &&
                        c.CategoryTypeName == "Expense")
                    .OrderBy(c => c.CategoryName)
                    .ToList();


            // =====================================================
            // LOAD RECEIVERS
            // =====================================================

            var allUsers =
                await UserService
                    .GetUsersAsync();

            Users =
                allUsers
                    .Where(u =>
                        u.IsActive &&
                        u.UserId != UserId)
                    .OrderBy(u => u.FirstName)
                    .ThenBy(u => u.LastName)
                    .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Unable to load the recurring payment form.";

            Console.WriteLine(ex);
        }
    }


    private async Task CreateRecurringPayment()
    {
        ErrorMessage = null;

        IsSaving = true;

        try
        {
            // =====================================================
            // VALIDATE RECEIVER
            // =====================================================

            if (RecurringPayment.ToUserId <= 0)
            {
                ErrorMessage =
                    "Please select a receiver.";

                return;
            }


            if (RecurringPayment.ToUserId == UserId)
            {
                ErrorMessage =
                    "You cannot create a recurring payment to yourself.";

                return;
            }


            var receiver =
                Users.FirstOrDefault(
                    u => u.UserId == RecurringPayment.ToUserId);

            if (receiver == null)
            {
                ErrorMessage =
                    "The selected receiver could not be found.";

                return;
            }


            // =====================================================
            // VALIDATE CATEGORY
            // =====================================================

            if (RecurringPayment.CategoryId <= 0)
            {
                ErrorMessage =
                    "Please select an expense category.";

                return;
            }


            var selectedCategory =
                Categories.FirstOrDefault(
                    c => c.CategoryId == RecurringPayment.CategoryId);

            if (selectedCategory == null)
            {
                ErrorMessage =
                    "The selected expense category could not be found.";

                return;
            }


            // =====================================================
            // VALIDATE AMOUNT
            // =====================================================

            if (RecurringPayment.Amount <= 0)
            {
                ErrorMessage =
                    "The payment amount must be greater than zero.";

                return;
            }


            // =====================================================
            // VALIDATE DATES
            // =====================================================

            if (RecurringPayment.EndDate.HasValue &&
                RecurringPayment.EndDate.Value.Date <
                RecurringPayment.StartDate.Date)
            {
                ErrorMessage =
                    "End date cannot be before the start date.";

                return;
            }


            // =====================================================
            // SET SYSTEM VALUES
            // =====================================================

            RecurringPayment.UserId =
                UserId;

            RecurringPayment.StartDate =
                RecurringPayment.StartDate.Date;

            RecurringPayment.NextPaymentDate =
                RecurringPayment.StartDate;

            RecurringPayment.TransactionType =
                "Expense";

            RecurringPayment.IsActive =
                true;


            // =====================================================
            // SAVE
            // =====================================================

            await RecurringPaymentService
                .AddRecurringPaymentAsync(
                    RecurringPayment);


            Navigation.NavigateTo(
                "/recurring-payments");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                ex.Message;

            Console.WriteLine(ex);
        }
        finally
        {
            IsSaving = false;
        }
    }
}