@page "/reports"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "User")]

@using System.Security.Claims
@using FinTrack.Models
@using FinTrack.Services.Interfaces

@inject IReportService ReportService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Reports | FinTrack</PageTitle>

<div class="reports-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="reports-header">

        <span class="reports-eyebrow">
            FINANCIAL ANALYTICS
        </span>

        <h1>Reports</h1>

        <p>
            Analyze your income and spending over any period.
        </p>

    </div>


    <!-- =====================================================
         ERROR
         ===================================================== -->

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="report-error">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <div>

                <strong>
                    Unable to generate report
                </strong>

                <span>
                    @ErrorMessage
                </span>

            </div>

        </div>
    }


    <!-- =====================================================
         FILTER PANEL
         ===================================================== -->

    <section class="report-filter-card">

        <!-- TRANSACTION TYPE -->

        <div class="filter-row filter-type-row">

            <div class="filter-label">
                Show:
            </div>

            <div class="radio-group">

                <label class="report-radio">

                    <input type="radio"
                           name="transactionType"
                           checked="@IsExpenseFilter"
                           @onclick="SetExpenseFilter" />

                    <span class="radio-circle"></span>

                    <span>
                        Expenses
                    </span>

                </label>


                <label class="report-radio">

                    <input type="radio"
                           name="transactionType"
                           checked="@IsIncomeFilter"
                           @onclick="SetIncomeFilter" />

                    <span class="radio-circle"></span>

                    <span>
                        Income
                    </span>

                </label>


                <label class="report-radio">

                    <input type="radio"
                           name="transactionType"
                           checked="@IsBothFilter"
                           @onclick="SetBothFilter" />

                    <span class="radio-circle"></span>

                    <span>
                        Both
                    </span>

                </label>

            </div>

        </div>


        <!-- DATE FILTERS -->

        <div class="filter-grid">

            <div class="filter-field">

                <label>
                    From:
                </label>

                <InputDate @bind-Value="FromDate"
                           class="report-input" />

            </div>


            <div class="filter-field">

                <label>
                    To:
                </label>

                <InputDate @bind-Value="ToDate"
                           class="report-input" />

            </div>


            <div class="filter-field">

                <label>
                    Period:
                </label>

                <select class="report-input"
                        @bind="SelectedPeriod"
                        @bind:after="ApplySelectedPeriod">

                    <option value="Custom">
                        Custom
                    </option>

                    <option value="Last7">
                        Last 7 days
                    </option>

                    <option value="Last30">
                        Last 30 days
                    </option>

                    <option value="Last90">
                        Last 90 days
                    </option>

                    <option value="ThisMonth">
                        This month
                    </option>

                    <option value="LastMonth">
                        Last month
                    </option>

                </select>

            </div>

        </div>


        <!-- CHART TYPE -->

        <div class="filter-row chart-type-row">

            <div class="filter-label">
                Chart:
            </div>

            <div class="radio-group chart-radio-group">

                <label class="report-radio">

                    <input type="radio"
                           name="chartType"
                           checked="@IsPieChart"
                           @onclick="SetPieChart" />

                    <span class="radio-circle"></span>

                    <span>
                        Pie chart
                    </span>

                </label>


                <label class="report-radio">

                    <input type="radio"
                           name="chartType"
                           checked="@IsBarChart"
                           @onclick="SetBarChart" />

                    <span class="radio-circle"></span>

                    <span>
                        Bar chart
                    </span>

                </label>

            </div>

        </div>


        <!-- SHOW REPORT -->

        <div class="filter-actions">

            <button type="button"
                    class="show-report-button"
                    @onclick="GenerateReportAsync"
                    disabled="@IsGenerating">

                @if (IsGenerating)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>

                    <span>
                        GENERATING...
                    </span>
                }
                else
                {
                    <span>
                        SHOW REPORT
                    </span>
                }

            </button>

        </div>

    </section>


    <!-- =====================================================
         LOADING
         ===================================================== -->

    @if (IsGenerating)
    {
        <div class="report-loading">

            <div class="report-loader"></div>

            <span>
                Preparing your financial report...
            </span>

        </div>
    }


    <!-- =====================================================
         REPORT RESULTS
         ===================================================== -->

    @if (!IsGenerating && HasReport)
    {
        <section class="report-results">

            <!-- RESULTS HEADER -->

            <div class="results-header">

                <div>

                    <span class="reports-eyebrow">
                        REPORT RESULTS
                    </span>

                    <h2>
                        @GetReportTitle()
                    </h2>

                    <p>
                        @Report.FromDate.ToString("dd MMM yyyy")
                        -
                        @Report.ToDate.ToString("dd MMM yyyy")
                    </p>

                </div>


                <div class="result-count">

                    <strong>
                        @Report.TransactionCount
                    </strong>

                    <span>
                        transactions
                    </span>

                </div>

            </div>


            <!-- =================================================
                 SUMMARY CARDS
                 ================================================= -->

            <div class="report-summary-grid">


                <!-- INCOME -->

                <div class="report-summary-card income-summary">

                    <div class="summary-icon">

                        <i class="bi bi-arrow-down-left"></i>

                    </div>

                    <div>

                        <span>
                            Total Income
                        </span>

                        <strong>
                            ₹@Report.TotalIncome.ToString("N0")
                        </strong>

                    </div>

                </div>


                <!-- EXPENSE -->

                <div class="report-summary-card expense-summary">

                    <div class="summary-icon">

                        <i class="bi bi-arrow-up-right"></i>

                    </div>

                    <div>

                        <span>
                            Total Expenses
                        </span>

                        <strong>
                            ₹@Report.TotalExpense.ToString("N0")
                        </strong>

                    </div>

                </div>


                <!-- NET -->

                <div class="report-summary-card net-summary">

                    <div class="summary-icon">

                        <i class="bi bi-wallet2"></i>

                    </div>

                    <div>

                        <span>
                            Net
                        </span>

                        <strong class="@(Report.NetAmount >= 0 ? "positive" : "negative")">

                            ₹@Report.NetAmount.ToString("N0")

                        </strong>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            @if (Report.Categories == null ||
                 !Report.Categories.Any())
            {
                <div class="report-empty">

                    <i class="bi bi-bar-chart-line"></i>

                    <strong>
                        No transactions found
                    </strong>

                    <span>
                        Try changing the date range or transaction type.
                    </span>

                </div>
            }
            else
            {

                <!-- =============================================
                     CHART CARD
                     ============================================= -->

                <div class="report-chart-card">

                    <div class="chart-card-header">

                        <div>

                            <span class="reports-eyebrow">
                                BREAKDOWN
                            </span>

                            <h3>
                                @GetChartTitle()
                            </h3>

                        </div>


                        <span class="chart-filter-badge">
                            @Report.TransactionFilter
                        </span>

                    </div>


                    <!-- =========================================
                         PIE CHART
                         ========================================= -->

                    @if (ChartType == "Pie")
                    {
                        <div class="pie-report-layout">

                            <div class="pie-chart-wrapper">

                                <div class="report-pie-chart"
                                     style="@GetPieChartStyle()">
                                </div>

                            </div>


                            <div class="pie-legend">

                                @foreach (var category in Report.Categories)
                                {
                                    <div class="legend-item">

                                        <span class="legend-color"
                                              style="background-color:@GetCategoryColor(category.CategoryId)">
                                        </span>


                                        <div class="legend-info">

                                            <strong>
                                                @category.CategoryName
                                            </strong>

                                            <span>
                                                @category.TransactionType
                                            </span>

                                        </div>


                                        <div class="legend-value">

                                            <strong>
                                                ₹@category.Amount.ToString("N0")
                                            </strong>

                                            <span>
                                                @category.Percentage%
                                            </span>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }
                    else
                    {

                        <!-- =====================================
                             BAR CHART
                             ===================================== -->

                        <div class="bar-report">

                            @foreach (var category in Report.Categories)
                            {
                                <div class="bar-item">

                                    <div class="bar-item-header">

                                        <div class="bar-category">

                                            <span class="category-dot"
                                                  style="background-color:@GetCategoryColor(category.CategoryId)">
                                            </span>


                                            <strong>
                                                @category.CategoryName
                                            </strong>


                                            <small>
                                                @category.TransactionType
                                            </small>

                                        </div>


                                        <div class="bar-amount">

                                            <strong>
                                                ₹@category.Amount.ToString("N0")
                                            </strong>

                                            <span>
                                                @category.Percentage%
                                            </span>

                                        </div>

                                    </div>


                                    <div class="bar-track">

                                        <div class="bar-fill"
                                             style="width:@GetBarWidth(category.Percentage); background-color:@GetCategoryColor(category.CategoryId);">
                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>


                <!-- =============================================
                     REPORT HIGHLIGHTS
                     ============================================= -->

                <div class="report-table-card">

                    <div class="chart-card-header">

                        <div>

                            <span class="reports-eyebrow">
                                HIGHLIGHTS
                            </span>

                            <h3>
                                What stands out
                            </h3>

                        </div>

                    </div>


                    <div class="report-summary-grid">

                        <div class="report-summary-card expense-summary">

                            <div class="summary-icon">
                                <i class="bi bi-arrow-up-right"></i>
                            </div>

                            <div>

                                <span>
                                    Largest Expense
                                </span>

                                <strong>
                                    @GetLargestExpenseCategory()
                                </strong>

                            </div>

                        </div>


                        <div class="report-summary-card income-summary">

                            <div class="summary-icon">
                                <i class="bi bi-arrow-down-left"></i>
                            </div>

                            <div>

                                <span>
                                    Largest Income
                                </span>

                                <strong>
                                    @GetLargestIncomeCategory()
                                </strong>

                            </div>

                        </div>


                        <div class="report-summary-card net-summary">

                            <div class="summary-icon">
                                <i class="bi bi-calculator"></i>
                            </div>

                            <div>

                                <span>
                                    Average Transaction
                                </span>

                                <strong>
                                    ₹@GetAverageTransaction().ToString("N0")
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            }

        </section>
    }

</div>


@code
{
    /*
     * IMPORTANT:
     * Report is intentionally NOT nullable.
     *
     * We use HasReport to decide whether the report
     * should be displayed.
     *
     * This prevents the previous NullReferenceException.
     */

    private FinancialReport Report = new();

    private bool HasReport = false;

    private bool IsGenerating = false;

    private string? ErrorMessage;

    private int UserId;

    private DateTime FromDate =
        DateTime.Today.AddDays(-29);

    private DateTime ToDate =
        DateTime.Today;

    private string TransactionFilter =
        "Both";

    private string ChartType =
        "Bar";

    private string SelectedPeriod =
        "Last30";


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                authenticationState.User;

            var claim =
                user.FindFirst(
                    ClaimTypes.NameIdentifier);

            if (claim == null ||
                !int.TryParse(
                    claim.Value,
                    out UserId))
            {
                ErrorMessage =
                    "Unable to identify the current user.";

                return;
            }

            ApplySelectedPeriod();
        }
        catch
        {
            ErrorMessage =
                "Unable to load the reports page.";
        }
    }


    // =========================================================
    // GENERATE REPORT
    // =========================================================

    private async Task GenerateReportAsync()
    {
        ErrorMessage = null;

        IsGenerating = true;

        HasReport = false;

        try
        {
            if (FromDate.Date > ToDate.Date)
            {
                ErrorMessage =
                    "From date cannot be after To date.";

                return;
            }


            var generatedReport =
                await ReportService.GenerateReportAsync(
                    UserId,
                    FromDate.Date,
                    ToDate.Date,
                    TransactionFilter);


            if (generatedReport == null)
            {
                ErrorMessage =
                    "No report could be generated.";

                return;
            }


            Report =
                generatedReport;

            HasReport = true;
        }
        catch (Exception ex)
        {
            HasReport = false;

            ErrorMessage =
                ex.Message;
        }
        finally
        {
            IsGenerating = false;
        }
    }


    // =========================================================
    // PERIOD
    // =========================================================

    private void ApplySelectedPeriod()
    {
        HasReport = false;

        ErrorMessage = null;

        var today =
            DateTime.Today;


        switch (SelectedPeriod)
        {
            case "Last7":

                FromDate =
                    today.AddDays(-6);

                ToDate =
                    today;

                break;


            case "Last30":

                FromDate =
                    today.AddDays(-29);

                ToDate =
                    today;

                break;


            case "Last90":

                FromDate =
                    today.AddDays(-89);

                ToDate =
                    today;

                break;


            case "ThisMonth":

                FromDate =
                    new DateTime(
                        today.Year,
                        today.Month,
                        1);

                ToDate =
                    today;

                break;


            case "LastMonth":

                var firstOfCurrentMonth =
                    new DateTime(
                        today.Year,
                        today.Month,
                        1);


                var lastMonth =
                    firstOfCurrentMonth
                        .AddMonths(-1);


                FromDate =
                    lastMonth;

                ToDate =
                    firstOfCurrentMonth
                        .AddDays(-1);

                break;
        }
    }


    // =========================================================
    // TRANSACTION FILTER
    // =========================================================

    private bool IsExpenseFilter =>
        TransactionFilter == "Expense";


    private bool IsIncomeFilter =>
        TransactionFilter == "Income";


    private bool IsBothFilter =>
        TransactionFilter == "Both";


    private void SetExpenseFilter()
    {
        TransactionFilter =
            "Expense";

        HasReport = false;

        ErrorMessage = null;
    }


    private void SetIncomeFilter()
    {
        TransactionFilter =
            "Income";

        HasReport = false;

        ErrorMessage = null;
    }


    private void SetBothFilter()
    {
        TransactionFilter =
            "Both";

        HasReport = false;

        ErrorMessage = null;
    }


    // =========================================================
    // CHART FILTER
    // =========================================================

    private bool IsPieChart =>
        ChartType == "Pie";


    private bool IsBarChart =>
        ChartType == "Bar";


    private void SetPieChart()
    {
        ChartType =
            "Pie";
    }


    private void SetBarChart()
    {
        ChartType =
            "Bar";
    }


    // =========================================================
    // TITLES
    // =========================================================

    private string GetReportTitle()
    {
        return TransactionFilter switch
        {
            "Income" =>
                "Income by Category",

            "Expense" =>
                "Expenses by Category",

            _ =>
                "Income & Expenses by Category"
        };
    }


    private string GetChartTitle()
    {
        return TransactionFilter switch
        {
            "Income" =>
                "Income by Category",

            "Expense" =>
                "Expenses by Category",

            _ =>
                "Income & Expenses by Category"
        };
    }


    // =========================================================
    // REPORT HIGHLIGHTS
    // =========================================================

    private string GetLargestExpenseCategory()
    {
        var category = Report.Categories?
            .Where(c => c.TransactionType == "Expense")
            .OrderByDescending(c => c.Amount)
            .FirstOrDefault();

        return category?.CategoryName ?? "No expense data";
    }


    private string GetLargestIncomeCategory()
    {
        var category = Report.Categories?
            .Where(c => c.TransactionType == "Income")
            .OrderByDescending(c => c.Amount)
            .FirstOrDefault();

        return category?.CategoryName ?? "No income data";
    }


    private decimal GetAverageTransaction()
    {
        if (Report.TransactionCount <= 0)
        {
            return 0;
        }

        var totalAmount =
            Report.TotalIncome + Report.TotalExpense;

        return totalAmount / Report.TransactionCount;
    }


    // =========================================================
    // BAR CHART
    // =========================================================

    private string GetBarWidth(
        decimal percentage)
    {
        var width =
            Math.Min(
                Math.Max(
                    percentage,
                    0),
                100);

        return
            $"{width:0.##}%";
    }


    // =========================================================
    // PIE CHART
    // =========================================================

    private string GetPieChartStyle()
    {
        if (Report.Categories == null ||
            !Report.Categories.Any())
        {
            return
                "background:#282d36;";
        }


        var segments =
            new List<string>();

        decimal current =
            0;


        foreach (var category
                 in Report.Categories)
        {
            var start =
                current;


            current +=
                category.Percentage;


            var color =
                GetCategoryColor(
                    category.CategoryId);


            segments.Add(
                $"{color} {start:0.##}% {current:0.##}%");
        }


        return
            $"background:conic-gradient({string.Join(", ", segments)});";
    }


    // =========================================================
    // CATEGORY COLORS
    // =========================================================

    private string GetCategoryColor(
        int categoryId)
    {
        var colors =
            new[]
            {
                "#3b82f6",
                "#22c55e",
                "#ef4444",
                "#a855f7",
                "#f59e0b",
                "#06b6d4",
                "#ec4899",
                "#84cc16",
                "#6366f1",
                "#f97316",
                "#14b8a6",
                "#eab308"
            };


        return
            colors[
                Math.Abs(categoryId)
                % colors.Length];
    }
}