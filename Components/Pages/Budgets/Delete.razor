@page "/budgets/delete/{Id:int}"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@attribute [Authorize(Roles = "User")]

@using System.Security.Claims
@using FinTrack.Models
@using FinTrack.Services.Interfaces

@inject IBudgetService BudgetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Delete Budget</PageTitle>

@if (IsLoading)
{
    <div class="alert alert-info">
        Loading budget...
    </div>
}
else if (NotFound)
{
    <div class="alert alert-danger">
        Budget not found.
    </div>

    <button type="button"
            class="btn btn-secondary"
            @onclick="Cancel">
        Back
    </button>
}
else
{
    <h2 class="text-danger">
        Delete Budget
    </h2>

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this budget?</strong>
        <br />
        This action cannot be undone.
    </div>

    <table class="table table-bordered">

        <tr>
            <th>Category</th>
            <td>
                @Budget.CategoryName
            </td>
        </tr>

        <tr>
            <th>Budget</th>
            <td>
                ₹ @Budget.LimitAmount.ToString("N2")
            </td>
        </tr>

        <tr>
            <th>Month</th>
            <td>
                @Budget.BudgetMonth / @Budget.BudgetYear
            </td>
        </tr>

    </table>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">
            @ErrorMessage
        </div>
    }

    <button type="button"
            class="btn btn-danger"
            disabled="@IsDeleting"
            @onclick="DeleteBudget">

        @(IsDeleting ? "Deleting..." : "Delete")

    </button>

    <button type="button"
            class="btn btn-secondary ms-2"
            disabled="@IsDeleting"
            @onclick="Cancel">

        Cancel

    </button>
}

@code
{
    [Parameter]
    public int Id { get; set; }

    private Budget Budget { get; set; } = new();

    private int UserId;

    private bool IsLoading = true;

    private bool IsDeleting;

    private bool NotFound;

    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var claim =
                authenticationState.User.FindFirst(
                    ClaimTypes.NameIdentifier);

            if (claim == null ||
                !int.TryParse(claim.Value, out UserId))
            {
                ErrorMessage =
                    "Unable to identify the current user.";

                return;
            }

            var budget =
                await BudgetService.GetBudgetAsync(
                    Id,
                    UserId);

            if (budget == null)
            {
                NotFound = true;
                return;
            }

            Budget = budget;
        }
        catch (Exception)
        {
            ErrorMessage =
                "Unable to load the budget right now.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task DeleteBudget()
    {
        try
        {
            IsDeleting = true;
            ErrorMessage = null;

            await BudgetService.DeleteBudgetAsync(
                Budget.BudgetId,
                UserId);

            Navigation.NavigateTo("/budgets");
        }
        catch (Exception)
        {
            ErrorMessage =
                "Unable to delete the budget right now.";
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/budgets");
    }
}