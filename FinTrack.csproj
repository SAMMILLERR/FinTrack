<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <!-- The test project lives beneath this web-project directory. Exclude its
       source and generated files from the application's default SDK glob. -->
  <ItemGroup>
    <Compile Remove="FinTrack.Tests\**\*.cs" />
    <Content Remove="FinTrack.Tests\**" />
    <EmbeddedResource Remove="FinTrack.Tests\**" />
    <None Remove="FinTrack.Tests\**" />
  </ItemGroup>
<ItemGroup>
  <Compile Remove="FinTrack.McpServer\**" />
  <Content Remove="FinTrack.McpServer\**" />
  <EmbeddedResource Remove="FinTrack.McpServer\**" />
  <None Remove="FinTrack.McpServer\**" />
</ItemGroup>
</Project>
