@page
@using System.Security.Claims
@model FinTrack.Pages.Users.IndexModel

<h2 class="mb-4">User Management</h2>

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>

            <th>Name</th>

            <th>Email</th>

            <th>Role</th>

            <th>Status</th>

            <th>Created</th>

            <th>Actions</th>

        </tr>

    </thead>

    <tbody>

@foreach (var user in Model.Users)
{
    <tr>

        <td>

            @user.FirstName @user.LastName

        </td>

        <td>

            @user.Email

        </td>

        <td>

            @if (user.RoleName == "Admin")
            {
                <span class="badge bg-danger">
                    Admin
                </span>
            }
            else
            {
                <span class="badge bg-primary">
                    User
                </span>
            }

        </td>

        <td>

            @if (user.IsActive)
            {
                <span class="badge bg-success">
                    Active
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    Inactive
                </span>
            }

        </td>

        <td>

            @user.CreatedOn.ToShortDateString()

        </td>

        <td>

            @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == user.UserId.ToString())
            {
                <span class="text-muted">
                    Current User
                </span>
            }
            else
            {
                <a asp-page="Role"
                   asp-route-id="@user.UserId"
                   asp-route-roleId="@user.RoleId"
                   class="btn btn-warning btn-sm">

                    @(user.RoleId == 1 ? "Make User" : "Make Admin")

                </a>

                <a asp-page="Status"
                   asp-route-id="@user.UserId"
                   asp-route-isActive="@user.IsActive"
                   class="btn btn-info btn-sm">

                    @(user.IsActive ? "Deactivate" : "Activate")

                </a>
            }

        </td>

    </tr>
}

    </tbody>

</table>