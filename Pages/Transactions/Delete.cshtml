@page
@model FinTrack.Pages.Transactions.DeleteModel

<h2 class="text-danger">
    Delete Transaction
</h2>

<div class="alert alert-danger">

    <h5>
        Are you sure you want to delete this transaction?
    </h5>

</div>

<table class="table table-bordered">

    <tr>
        <th>Date</th>
        <td>@Model.Transaction.TransactionDate.ToShortDateString()</td>
    </tr>

    <tr>
        <th>Category</th>
        <td>@Model.Transaction.CategoryName</td>
    </tr>

    <tr>
        <th>Amount</th>
        <td>₹ @Model.Transaction.Amount</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.Transaction.Description</td>
    </tr>

</table>

<form method="post">

    <input asp-for="Transaction.TransactionId"
           type="hidden"/>

    <button type="submit"
            class="btn btn-danger">

        Delete

    </button>

    <a asp-page="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>