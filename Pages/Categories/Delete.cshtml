@page
@model FinTrack.Pages.Categories.DeleteModel

<h2 class="text-danger">
    Delete Category
</h2>

<div class="alert alert-danger">

    Are you sure you want to delete this category?

</div>

<form method="post">

    <input asp-for="Category.CategoryId" type="hidden"/>

    <dl class="row">

        <dt class="col-sm-3">
            Name
        </dt>

        <dd class="col-sm-9">
            @Model.Category.CategoryName
        </dd>

        <dt class="col-sm-3">
            Type
        </dt>

        <dd class="col-sm-9">
            @Model.Category.CategoryTypeName
        </dd>

    </dl>

    <button type="submit"
            class="btn btn-danger">

        Delete

    </button>

    <a asp-page="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>