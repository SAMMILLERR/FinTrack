@page
@model FinTrack.Pages.Categories.EditModel

<h2>Edit Category</h2>

<form method="post">

    <!-- Important: sends the existing ID back on POST -->
    <input type="hidden" asp-for="Category.CategoryId" />

    <div class="mb-3">
        <label asp-for="Category.CategoryName"></label>
        <input asp-for="Category.CategoryName"
               class="form-control" />

        <span asp-validation-for="Category.CategoryName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Category Type</label>

        <select asp-for="Category.CategoryTypeId"
                asp-items="Model.CategoryTypes"
                class="form-select">
        </select>
    </div>

    <div class="form-check">
        <input asp-for="Category.IsActive"
               class="form-check-input" />

        <label asp-for="Category.IsActive"></label>
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Update
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>