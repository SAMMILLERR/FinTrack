@page
@model FinTrack.Pages.Reports.IndexModel

@using System.Text.Json

<h2 class="mb-4">

    Expense Report

</h2>

<p>

    <a asp-page-handler="Export"
       class="btn btn-success">

        <i class="bi bi-file-earmark-arrow-down"></i>

        Export CSV

    </a>

</p>

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>

            <th>Category</th>

            <th>Total Amount</th>

        </tr>

    </thead>

    <tbody>

@foreach(var item in Model.Reports)
{
        <tr>

            <td>

                @item.CategoryName

            </td>

            <td>

                ₹ @item.TotalAmount

            </td>

        </tr>
}

    </tbody>

</table>

<hr/>

<div class="row">

    <div class="col-md-6">

        <canvas id="pieChart"></canvas>

    </div>

    <div class="col-md-6">

        <canvas id="barChart"></canvas>

    </div>

</div>

@section Scripts
{

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const labels =
@Html.Raw(
JsonSerializer.Serialize(
Model.Reports.Select(x=>x.CategoryName)));

const values =
@Html.Raw(
JsonSerializer.Serialize(
Model.Reports.Select(x=>x.TotalAmount)));

new Chart(
document.getElementById("pieChart"),
{
type:'pie',

data:{

labels:labels,

datasets:[{

data:values

}]
}
});

new Chart(
document.getElementById("barChart"),
{
type:'bar',

data:{

labels:labels,

datasets:[{

label:'Expenses',

data:values

}]
}
});

</script>

}