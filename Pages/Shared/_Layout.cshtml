<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - FinTrack</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dark.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FinTrack.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-page="@(User.Identity?.IsAuthenticated == true
                    ? (User.IsInRole("Admin")
                        ? "/Transactions/Index"
                        : "/Dashboard/Index")
                    : "/Index")">

                <i class="bi bi-wallet2"></i>

                FinTrack

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <!-- LEFT MENU -->

                <ul class="navbar-nav me-auto">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Transactions") ? "active" : "")"
                                   asp-page="/Transactions/Index">

                                    <i class="bi bi-list-check"></i>

                                    All Transactions

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Categories") ? "active" : "")"
                                   asp-page="/Categories/Index">

                                    <i class="bi bi-tags"></i>

                                    Categories

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Users") ? "active" : "")"
                                   asp-page="/Users/Index">

                                    <i class="bi bi-people"></i>

                                    Users

                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Dashboard") ? "active" : "")"
                                   asp-page="/Dashboard/Index">

                                    <i class="bi bi-speedometer2"></i>

                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Transactions") ? "active" : "")"
                                   asp-page="/Transactions/Index">

                                    <i class="bi bi-cash-stack"></i>

                                    Transactions

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Budgets") ? "active" : "")"
                                   asp-page="/Budgets/Index">

                                    <i class="bi bi-piggy-bank"></i>

                                    Budgets

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Reports") ? "active" : "")"
                                   asp-page="/Reports/Index">

                                    <i class="bi bi-bar-chart-line"></i>

                                    Reports

                                </a>

                            </li>
                        }
                    }

                </ul>

                <!-- RIGHT MENU -->

                <ul class="navbar-nav align-items-center">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-3">

                            <button id="themeToggle"
                                    class="btn btn-outline-light btn-sm">

                                🌙 Dark

                            </button>

                        </li>

                        <li class="nav-item">

                            <span class="navbar-text text-white">

                                <i class="bi bi-person-circle"></i>

                                @User.Identity?.Name

                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-2">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary ms-2">
                                        User
                                    </span>
                                }

                            </span>

                        </li>

                        <li class="nav-item ms-3">

                            <a class="nav-link text-warning"
                               asp-page="/Account/Logout">

                                <i class="bi bi-box-arrow-right"></i>

                                Logout

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Account/Login">

                                <i class="bi bi-box-arrow-in-right"></i>

                                Login

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Account/Register">

                                <i class="bi bi-person-plus"></i>

                                Register

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <!-- MAIN CONTENT -->

    <main class="container mt-4 mb-5 flex-grow-1">

        @RenderBody()

    </main>

    <!-- FOOTER -->

    <footer class="bg-dark text-white text-center py-3 mt-auto">

        <div class="container">

            © @DateTime.Now.Year FinTrack • Personal Expense & Budget Manager

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script>

        const btn = document.getElementById("themeToggle");

        if (localStorage.getItem("theme") === "dark") {

            document.body.classList.add("dark-mode");

            if (btn)
                btn.innerHTML = "☀️ Light";
        }

        if (btn) {

            btn.addEventListener("click", function () {

                document.body.classList.toggle("dark-mode");

                if (document.body.classList.contains("dark-mode")) {

                    localStorage.setItem("theme", "dark");

                    btn.innerHTML = "☀️ Light";

                }
                else {

                    localStorage.setItem("theme", "light");

                    btn.innerHTML = "🌙 Dark";

                }

            });

        }

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>