@page
@model FinTrack.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">
    Dashboard
</h2>

@if (Model.Dashboard.Budgets.Any(x => x.UsagePercentage >= 90))
{
    <div class="alert alert-warning">

        <h5>
            ⚠ Budget Alerts
        </h5>

        <ul class="mb-0">

            @foreach (var item in Model.Dashboard.Budgets.Where(x => x.UsagePercentage >= 90))
            {
                <li>

                    <strong>@item.CategoryName</strong>

                    has used

                    <strong>@item.UsagePercentage.ToString("0")%</strong>

                    of its budget.

                </li>
            }

        </ul>

    </div>
}
else
{
    <div class="alert alert-success">

        ✅ Great! All budgets are under control.

    </div>
}

<div class="row">

    <div class="col-md-4 mb-3">

        <div class="card bg-success text-white shadow">

            <div class="card-body text-center">

                <h5>Total Income</h5>

                <h2>

                    ₹ @Model.Dashboard.Summary.TotalIncome

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-4 mb-3">

        <div class="card bg-danger text-white shadow">

            <div class="card-body text-center">

                <h5>Total Expense</h5>

                <h2>

                    ₹ @Model.Dashboard.Summary.TotalExpense

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-4 mb-3">

        <div class="card bg-primary text-white shadow">

            <div class="card-body text-center">

                <h5>Balance</h5>

                <h2>

                    ₹ @Model.Dashboard.Summary.Balance

                </h2>

            </div>

        </div>

    </div>

</div>

<hr />

<h3 class="mb-3">

    Budget Usage

</h3>

<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>

            <th>Category</th>

            <th>Budget</th>

            <th>Spent</th>

            <th>Remaining</th>

            <th width="280">

                Progress

            </th>

        </tr>

    </thead>

    <tbody>

@foreach (var item in Model.Dashboard.Budgets)
{
    var percentage = item.UsagePercentage;

    var color = percentage >= 100
        ? "bg-danger"
        : percentage >= 90
            ? "bg-warning"
            : "bg-success";

    var width = percentage > 100 ? 100 : percentage;

    <tr>

        <td>

            @item.CategoryName

        </td>

        <td>

            ₹ @item.LimitAmount

        </td>

        <td>

            ₹ @item.SpentAmount

        </td>

        <td>

            ₹ @item.RemainingAmount

        </td>

        <td>

            <div class="progress">

                <div class="progress-bar @color"
                     role="progressbar"
                     style="width:@width%">

                    @percentage.ToString("0")%

                </div>

            </div>

        </td>

    </tr>
}

    </tbody>

</table>

<hr />

<h3>

    Recent Transactions

</h3>

<table class="table table-hover">

    <thead class="table-secondary">

        <tr>

            <th>Date</th>

            <th>Category</th>

            <th>Type</th>

            <th>Amount</th>

        </tr>

    </thead>

    <tbody>

@foreach (var item in Model.Dashboard.RecentTransactions)
{
    <tr>

        <td>

            @item.TransactionDate.ToShortDateString()

        </td>

        <td>

            @item.CategoryName

        </td>

        <td>

            @if (item.TransactionType == "Income")
            {
                <span class="badge bg-success">

                    Income

                </span>
            }
            else
            {
                <span class="badge bg-danger">

                    Expense

                </span>
            }

        </td>

        <td>

            @if (item.TransactionType == "Income")
            {
                <span class="text-success fw-bold">

                    + ₹ @item.Amount

                </span>
            }
            else
            {
                <span class="text-danger fw-bold">

                    - ₹ @item.Amount

                </span>
            }

        </td>

    </tr>
}

    </tbody>

</table>