@page
@model FinTrack.Pages.Budgets.DeleteModel

<h2 class="text-danger">
    Delete Budget
</h2>

<div class="alert alert-danger">

    Are you sure you want to delete this budget?

</div>

<table class="table table-bordered">

    <tr>

        <th>Category</th>

        <td>@Model.Budget.CategoryName</td>

    </tr>

    <tr>

        <th>Budget</th>

        <td>₹ @Model.Budget.LimitAmount</td>

    </tr>

    <tr>

        <th>Month</th>

        <td>@Model.Budget.BudgetMonth / @Model.Budget.BudgetYear</td>

    </tr>

</table>

<form method="post">

    <input asp-for="Budget.BudgetId"
           type="hidden"/>

    <button class="btn btn-danger">

        Delete

    </button>

    <a asp-page="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>